#!/bin/bash
#SBATCH --job-name=rag_online
#SBATCH --output=logs/rag_online_%j.out
#SBATCH --error=logs/rag_online_%j.err
#SBATCH --cpus-per-task=16
#SBATCH --mem=96G
#SBATCH --nodes=1
#SBATCH --gres=gpu:h100:1
#SBATCH --time=24:00:00
#SBATCH --partition=scavenge
#SBATCH --mail-type=fail,end

set -eo pipefail

USAGE="Usage: sbatch run_rag_online.job <db_path> <config> [name] [--set k=v ...]"
DB_PATH="${1:?$USAGE}"
# The config is REQUIRED and is not defaulted here or in the phase: an eval must
# name the configuration it ran, or its report cannot be traced back to one.
CONFIG="${2:?$USAGE   (config missing) e.g. baseline}"
shift 2
RUN_NAME="run"
if [[ -n "$1" && "$1" != --* ]]; then RUN_NAME="$1"; shift 1; fi
OVERRIDES=("$@")

cd RAGNAR || { echo "Cannot cd to RAGNAR from $PWD - aborting"; exit 1; }

# Check the index before paying for Ollama startup, the model pull and the warm-up.
# A missing index used to surface only after all of that, at load time.
# Each backend writes its own artifacts: FAISS a .faiss + .pkl pair, Chroma a
# .chroma_meta.pkl pointing at its persist directory. Checking only for the FAISS
# pair aborted every chroma run before it started.
if [[ -f "${DB_PATH}.faiss" && -f "${DB_PATH}.pkl" ]]; then
    :
elif [[ -f "${DB_PATH}.chroma_meta.pkl" ]]; then
    :
else
    echo "Index not found: expected ${DB_PATH}.faiss + ${DB_PATH}.pkl (faiss)"
    echo "                 or ${DB_PATH}.chroma_meta.pkl (chroma), in $PWD"
    exit 1
fi

module --ignore_cache load CUDA/12.6.0
module --ignore_cache load "ollama/0.6.0-GCCcore-13.3.0-CUDA-12.6.0"

source ~/Miniconda3-py312_25.9.1-3-Linux-x86_64_MAIN/etc/profile.d/conda.sh
conda activate rag_gpu

# The CUDA and ollama modules are EasyBuild GCCcore/13.3.0 builds, and they put
# that toolchain's libstdc++ on LD_LIBRARY_PATH ahead of the conda env's own.
# conda-forge's libfaiss.so is built against GCC 14 and needs CXXABI_1.3.15;
# GCCcore 13.3.0 only provides up to 1.3.14, so `import faiss` dies with
#   libstdc++.so.6: version `CXXABI_1.3.15' not found (required by libfaiss.so)
# unless the env's own lib directory is searched first. Must come AFTER
# `conda activate` — $CONDA_PREFIX is not set until then.
export LD_LIBRARY_PATH="$CONDA_PREFIX/lib:$LD_LIBRARY_PATH"

# Presence check only. find_spec RESOLVES each module without EXECUTING it, so this
# costs milliseconds, where the old `python -c "import torch, sentence_transformers,
# faiss, numpy"` paid a full import — tens of seconds to minutes for torch and
# transformers off the conda env on NFS — purely to discover the env was fine.
# online_phase imports the same modules for real moments later, so that check bought
# nothing but a duplicated cost, inside a ~19-minute job whose measured build was ~8s.
#
# What this deliberately does NOT catch: a faiss that cannot load its shared library
# (the CXXABI mismatch handled above), or a torch built for the wrong CUDA that reports
# no GPU and silently falls back to the CPU. Both need a real import and a launched
# kernel; both are verified once per env in run_rag_env.job, which is where that cost
# belongs. A broken-but-present package now surfaces at online_phase's own import
# instead — the same failure, a few seconds later, for free.
python -c "
import importlib.util as util, sys
missing = []
for name in sys.argv[1:]:
    try:
        if util.find_spec(name) is None:
            missing.append(name)
    except Exception:
        # A package broken enough that find_spec itself raises is not usable either:
        # report it as missing rather than dying here with a traceback.
        missing.append(name)
if missing:
    sys.exit('rag_gpu env is missing online dependencies: ' + ', '.join(missing)
             + ' - run run_rag_env.job')
" torch sentence_transformers faiss numpy ollama pandas rouge_score bert_score || exit 1

# Free, and catches from the other side the failure run_rag_env.job warns about: with
# no GPU visible every embedding pass runs on the CPU, which looks like a slow job
# rather than a broken one. --gres should guarantee a device, so an empty list here is
# a real problem and not a scheduling artefact.
nvidia-smi -L > /dev/null 2>&1 \
    || { echo "No GPU visible to this job - online work would silently run on the CPU"; exit 1; }

echo "===== SLURM ENV ====="
echo "Job ID             : $SLURM_JOB_ID"
echo "Node               : $SLURMD_NODENAME"
echo "CUDA_VISIBLE_DEVICES: $CUDA_VISIBLE_DEVICES"
echo "DB path            : $PWD/$DB_PATH"
echo "Started at         : $(date +%Y-%m-%dT%H:%M:%S)"

# --- Start Ollama server ---
echo ""
echo "===== STARTING OLLAMA ====="
mkdir -p results

OLLAMA_LOG="results/ollama_${SLURM_JOB_ID}.log"
ollama serve > "$OLLAMA_LOG" 2>&1 &
OLLAMA_PID=$!
echo "Ollama log         : $PWD/$OLLAMA_LOG"

# Always reap the server, including on an early exit from `set -e` below —
# otherwise a failure between here and the cleanup section leaves it running.
cleanup() {
    if kill -0 "$OLLAMA_PID" 2>/dev/null; then
        echo "Stopping Ollama (PID: $OLLAMA_PID)..."
        kill "$OLLAMA_PID" 2>/dev/null || true
        wait "$OLLAMA_PID" 2>/dev/null || true
    fi
}
trap cleanup EXIT

# Print what the server said, so a failure is diagnosable from the job's own log.
die() {
    echo "$1" >&2
    echo "----- last 40 lines of $OLLAMA_LOG -----" >&2
    tail -n 40 "$OLLAMA_LOG" >&2 || true
    exit 1
}

OLLAMA_RETRIES=0
until curl -s http://localhost:11434 > /dev/null; do
    sleep 1
    OLLAMA_RETRIES=$((OLLAMA_RETRIES + 1))
    if [[ $OLLAMA_RETRIES -ge 120 ]]; then
        die "Ollama failed to start after 120s — aborting"
    fi
done
echo "Ollama PID: $OLLAMA_PID"

# Read the model from the same config the eval will use. Hard-coding it here is
# how a job ends up pulling one model and evaluating with another.
GEN_MODEL=$(python -m rag_pipeline.config "$CONFIG" --get online.generator.model "${OVERRIDES[@]}") \
    || die "Could not read online.generator.model from $CONFIG"

echo "Warming up model: $GEN_MODEL"
ollama pull "$GEN_MODEL" || die "ollama pull $GEN_MODEL failed — aborting before the eval"
ollama run "$GEN_MODEL" "hi" > /dev/null 2>&1 \
    || die "ollama run $GEN_MODEL warm-up failed — model pulled but not usable"
echo "Ollama ready."

# --- Run online evaluation ---
echo ""
echo "===== RUNNING ONLINE EVALUATION ====="
echo "Config             : $CONFIG"
echo "Run name           : $RUN_NAME"
echo "Overrides          : ${OVERRIDES[*]:-none}"
./monitor.sh results/hardware_online_${SLURM_JOB_ID}.csv \
    python -m rag_pipeline.online_phase \
        --db "$DB_PATH" --config "$CONFIG" --name "$RUN_NAME" "${OVERRIDES[@]}"

echo ""
echo "===== DONE ====="
echo "Finished at: $(date +%Y-%m-%dT%H:%M:%S)"

# --- Cleanup ---
cleanup
trap - EXIT
echo "Ollama stopped."
