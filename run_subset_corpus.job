#!/bin/bash
#SBATCH --job-name=subset_corpus_%j
#SBATCH --output=logs/subset_corpus_%j.out
#SBATCH --error=logs/subset_corpus_%j.err
#SBATCH --cpus-per-task=2
#SBATCH --mem=16G
#SBATCH --nodes=1
#SBATCH --time=01:00:00
#SBATCH --partition=scavenge

# Usage: sbatch run_subset_corpus.job [n_articles] [output] [source]
set -eo pipefail

N_ARTICLES="${1:-1000}"
OUTPUT="${2:-data/wikiDump/articles_${N_ARTICLES}.jsonl}"
SOURCE="${3:-data/wikiDump/articles.jsonl}"

source ~/Miniconda3-py312_25.9.1-3-Linux-x86_64_MAIN/etc/profile.d/conda.sh
conda activate rag_gpu

cd RAGNAR || { echo "Cannot cd to RAGNAR from $PWD"; exit 1; }

python -m rag_pipeline.subset_article_corpus "$N_ARTICLES" "$OUTPUT" "$SOURCE"
ls -lh "$OUTPUT"
