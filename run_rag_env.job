#!/bin/bash
#SBATCH --job-name=rag_env
#SBATCH --output=logs/rag_env_%j.out
#SBATCH --error=logs/rag_env_%j.err
#SBATCH --cpus-per-task=1
#SBATCH --mem=32G
#SBATCH --nodes=1
#SBATCH --time=07:30:00
#SBATCH --partition=scavenge
#SBATCH --mail-type=end,fail

set -eo pipefail

module load CUDA/12.6.0
module load ollama/0.6.0-GCCcore-13.3.0-CUDA-12.6.0

CONDA=/home/jete/Miniconda3-py312_25.9.1-3-Linux-x86_64_MAIN

# Source conda so activate works in a batch script
source "$CONDA/etc/profile.d/conda.sh"

# Create env, skip if it already exists.
if conda env list | grep -qE "^rag_gpu[[:space:]]"; then
    echo "Env rag_gpu already exists, skipping create"
else
    echo "Creating env rag_gpu..."
    "$CONDA/bin/conda" create -y -n rag_gpu python=3.12
fi

conda activate rag_gpu

echo ""
echo "===== INSTALLING PACKAGES ====="
pip install \
    torch \
    sentence-transformers \
    transformers \
    faiss-gpu-cu12 \
    ollama \
    numpy \
    pandas \
    rouge-score \
    bert-score \
    chromadb

# --- Verify install
echo ""
echo "===== VERIFYING ====="
python - <<'PY'
import importlib, sys

# (import name, why it is needed)
required = [
    ("torch",                 "components/embedders.py"),
    ("sentence_transformers", "embedders.py, rerankers.py"),
    ("faiss",                 "components/databases.py"),
    ("ollama",                "components/generators.py — online phase"),
    ("numpy",                 "everywhere"),
    ("pandas",                "loadDatasetNQ.py — online phase"),
    ("rouge_score",           "metrics.py — online phase"),
    ("bert_score",            "metrics.py — online phase"),
]

failed = []
for name, why in required:
    try:
        m = importlib.import_module(name)
        print(f"  OK    {name:22s} {getattr(m, '__version__', 'unknown version')}")
    except Exception as exc:
        print(f"  FAIL  {name:22s} {type(exc).__name__}: {exc}  ({why})")
        failed.append(name)

# GPU visibility is reported, not enforced: this job requests no --gres, so a
# missing GPU here says nothing about the compute nodes the real jobs land on.
# Add "#SBATCH --gres=gpu:h100:1" above if you want these two lines to mean something.
try:
    import torch, faiss
    print(f"  info  torch.cuda.is_available() = {torch.cuda.is_available()}")
    print(f"  info  faiss.get_num_gpus()      = {faiss.get_num_gpus()}")
except Exception as exc:
    print(f"  info  GPU check unavailable: {exc}")

if failed:
    sys.exit(f"Missing packages: {', '.join(failed)}")
print("All required imports OK")
PY

# --- Record what was actually installed ---
echo ""
echo "===== FREEZING ====="
mkdir -p RAGNAR/results
pip freeze > "RAGNAR/results/requirements-hpc_${SLURM_JOB_ID}.txt"
echo "Wrote RAGNAR/results/requirements-hpc_${SLURM_JOB_ID}.txt"

echo ""
echo "===== DONE ====="
echo "Finished at: $(date +%Y-%m-%dT%H:%M:%S)"
