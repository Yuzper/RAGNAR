#!/bin/bash
#SBATCH --job-name=rag_offline_%j
#SBATCH --output=logs/rag_offline_%j.out
#SBATCH --error=logs/rag_offline_%j.err
#SBATCH --cpus-per-task=8
#SBATCH --mem=160G
#SBATCH --nodes=1
#SBATCH --nodelist=cn[7]
#SBATCH --gres=gpu:a100_80gb:1
#SBATCH --time=24:00:00
#SBATCH --partition=scavenge
#SBATCH --mail-type=fail,end

module --ignore_cache load CUDA/12.6.0

source ~/Miniconda3-py312_25.9.1-3-Linux-x86_64_MAIN/etc/profile.d/conda.sh
conda activate rag_gpu

echo "===== SLURM ENV ====="
echo "Job ID             : $SLURM_JOB_ID"
echo "Node               : $SLURMD_NODENAME"
echo "CUDA_VISIBLE_DEVICES: $CUDA_VISIBLE_DEVICES"
echo "Started at         : $(date +%Y-%m-%dT%H:%M:%S)"

# No Ollama needed for the offline build phase

# --- Run offline build ---
echo ""
echo "===== RUNNING OFFLINE BUILD ====="
cd RAGNAR
./monitor.sh results/hardware_offline_${SLURM_JOB_ID}.csv \
    python -m rag_pipeline.offline_phase

echo ""
echo "===== DONE ====="
echo "Finished at: $(date +%Y-%m-%dT%H:%M:%S)"
echo ""
echo "To run the online phase against this index:"
echo "  sbatch sbatch_online.sh results/FAISSDB_${SLURM_JOB_ID}.index"
